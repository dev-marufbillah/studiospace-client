# ============================================================
# StudioSpace Client - Environment Variables
# Copy to `.env.local` and fill in real values. NEVER commit .env files.
# ============================================================

# Public site origin (links, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Express API origin. Used by the Next.js rewrite proxy in next.config.ts
# (server-side) so the browser always calls same-origin /api/* paths.
NEXT_PUBLIC_API_URL=http://localhost:5001
# Preferred server-side override for production (never exposed to the browser).
# If unset, NEXT_PUBLIC_API_URL is used.
API_URL=

# Better Auth (https://www.better-auth.com/docs)
BETTER_AUTH_URL=http://localhost:3000
# Extra origins Better Auth should accept (comma separated). Next.js moves to
# another port when 3000 is busy, which otherwise fails with "Invalid origin".
# Dev ports localhost:3000-3003 / 127.0.0.1:3000-3003 are already allowed
# automatically outside production; add your production domain here as well.
TRUSTED_ORIGINS=
# Generate with: openssl rand -hex 32   (server-only, never NEXT_PUBLIC)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth - https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB (used by Better Auth's MongoDB adapter - same DB as the API)
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=studiospace

# Server-to-server secret shared with studiospace-server. The Next.js
# /api/session route presents it when exchanging a verified Better Auth
# session for an application JWT. Must match the server's value.
INTERNAL_API_SECRET=replace-with-another-long-random-secret

# Optional: direct browser -> imgbb upload key (https://api.imgbb.com/)
# Used only as a fallback when the server-side IMGBB_API_KEY is not set.
NEXT_PUBLIC_IMGBB_API_KEY=
# Optional: server-side imgbb key consumed by POST /api/upload (preferred).
IMGBB_API_KEY=
